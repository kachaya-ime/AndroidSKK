<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <PreferenceCategory
        android:title="設定項目"
        app:iconSpaceReserved="false"
        />

    <Preference
        android:key="pref_input"
        android:summary="SandS、句読点、Ctrlショートカットなど"
        android:title="入力設定"
        app:fragment="io.github.kachaya.skk.SettingsActivity$InputSettingsFragment"
        />

    <Preference
        android:key="pref_display"
        android:summary="▽▼表示、ツールチップなど"
        android:title="表示設定"
        app:fragment="io.github.kachaya.skk.SettingsActivity$DisplaySettingsFragment"
        />

    <Preference
        android:key="pref_physical_keyboard"
        android:summary="日本語配列物理キーボードの使用"
        android:title="物理キーボード設定"
        app:fragment="io.github.kachaya.skk.SettingsActivity$PhysicalKeyboardSettingsFragment"
        />

    <Preference
        android:key="pref_keyboard"
        android:summary="候補スタイル、キーボードの種類、高さなど"
        android:title="画面キーボード設定"
        app:fragment="io.github.kachaya.skk.SettingsActivity$KeyboardSettingsFragment"
        />

    <Preference
        android:key="pref_dictionary"
        android:summary="変換学習、ユーザー辞書、外部辞書インポート、配列カスタマイズなど"
        android:title="辞書・学習設定"
        app:fragment="io.github.kachaya.skk.SettingsActivity$DictionarySettingsFragment"
        />

    <PreferenceCategory
        android:title="画面キーボード配列のカスタマイズ"
        app:iconSpaceReserved="false"
        >
        <Preference
            android:key="symbols_customizer"
            android:summary="記号バーのキー配列をカスタマイズします"
            android:title="記号バーのカスタマイズ"
            >
            <intent
                android:targetClass="io.github.kachaya.skk.keyboard.KeyboardCustomizerActivity"
                android:targetPackage="io.github.kachaya.skk"
                >
                <extra android:name="pref_key"
                    android:value="combined_symbols"
                    />
                <extra android:name="title"
                    android:value="記号バーのカスタマイズ"
                    />
            </intent>
        </Preference>

        <Preference
            android:key="keyboard_customizer_qwerty"
            android:summary="QWERTYキーボードのキー配列をカスタマイズします"
            android:title="QWERTYキー配列のカスタマイズ"
            >
            <intent
                android:targetClass="io.github.kachaya.skk.keyboard.KeyboardCustomizerActivity"
                android:targetPackage="io.github.kachaya.skk"
                >
                <extra android:name="pref_key"
                    android:value="custom_qwerty_layout"
                    />
                <extra android:name="title"
                    android:value="QWERTY配列のカスタマイズ"
                    />
            </intent>
        </Preference>

        <Preference
            android:key="keyboard_customizer_tablet"
            android:summary="Tabletキーボードのキー配列をカスタマイズします"
            android:title="Tabletキー配列のカスタマイズ"
            >
            <intent
                android:targetClass="io.github.kachaya.skk.keyboard.KeyboardCustomizerActivity"
                android:targetPackage="io.github.kachaya.skk"
                >
                <extra android:name="pref_key"
                    android:value="custom_tablet_layout"
                    />
                <extra android:name="title"
                    android:value="Tablet配列のカスタマイズ"
                    />
            </intent>
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:title="バックアップ・復元"
        app:iconSpaceReserved="false"
        />
    <Preference
        android:key="backup_settings"
        android:summary="現在の設定をバックアップファイルに保存します"
        android:title="設定のバックアップ"
        />
    <Preference
        android:key="restore_settings"
        android:summary="保存したバックアップファイルから設定を復元します"
        android:title="設定の復元"
        />
    <Preference
        android:key="reset_settings"
        android:summary="設定を初期状態に戻します（学習辞書は初期化されません）"
        android:title="設定の初期化"
        />

    <PreferenceCategory
        android:title="アプリ情報"
        app:iconSpaceReserved="false"
        />
    <Preference
        app:key="app_version"
        app:selectable="false"
        app:title="バージョン"
        />
    <Preference
        android:key="legal_info"
        android:summary="オープンソースライセンス、商標免責、および免責事項"
        android:title="法的情報・ライセンス"
        />
</PreferenceScreen>
