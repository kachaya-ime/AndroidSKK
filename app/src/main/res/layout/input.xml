<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/candidate_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/candidate_height"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/candidate_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidates_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <!-- Java側でボタンが動的に追加される -->
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_expand_candidates"
            style="@style/CandidateButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:text="▼"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/candidate_expanded_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tooltip_background"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/candidate_expanded_flexbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:alignItems="center" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Java側でボタンが動的に追加される -->
    </LinearLayout>
</LinearLayout>
