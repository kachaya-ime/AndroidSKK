<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="FunctionButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_function_button_selector</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/function_button_fg</item>
    </style>

    <style name="CharacterButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_character_button_selector</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/character_button_fg</item>
        <item name="android:textSize" tools:ignore="SpUsage">22dp</item>
    </style>

    <style name="FunctionalKeyButton" parent="CharacterButton">
        <item name="android:background">@drawable/bg_function_button_selector</item>
        <item name="android:textColor">@color/function_button_fg</item>
    </style>

    <style name="CandidateButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_candidate_button_selector</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/candidate_button_fg</item>
        <item name="android:textSize" tools:ignore="SpUsage">24dp</item>
    </style>

    <!-- ユーザー辞書由来の候補用スタイル -->
    <style name="UserCandidateButton" parent="CandidateButton">
        <item name="android:textColor">@color/candidate_user_dict_fg</item>
    </style>

</resources>
