<?xml version="1.0" encoding="utf-8"?>
<inset
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="1dp"
    android:insetTop="1dp"
    android:insetRight="1dp"
    android:insetBottom="1dp"
    >

    <selector>

        <!-- 無効時（文字なし）：背景と同じ -->
        <item android:state_enabled="false">
            <shape android:shape="rectangle">
                <solid android:color="@color/keyboard_bg" />
            </shape>
        </item>

        <!-- 押したとき -->
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/candidate_button_bg_pressed" />
            </shape>
        </item>

        <!-- 選択状態（SKKでの現在選択中の候補など） -->
        <item android:state_selected="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/candidate_button_bg_selected" />
            </shape>
        </item>

        <!-- 通常時 -->
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/candidate_button_bg_normal" />
            </shape>
        </item>
    </selector>
</inset>

