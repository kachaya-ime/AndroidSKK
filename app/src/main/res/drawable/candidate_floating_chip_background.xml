<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/button_bg_selected" />
            <corners android:radius="6dp" />
            <stroke android:width="1.5dp" android:color="@color/neutral_variant_90" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/neutral_variant_20" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/function_bg_tint" />
        </shape>
    </item>
</selector>
